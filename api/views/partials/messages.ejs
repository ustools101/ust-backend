<%# Flash Messages Partial %>
<% if(typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="bg-[#e6f3e6] border border-[#c3e6cb] text-[#155724] px-4 py-3 rounded text-center mb-4" role="alert">
        <%= success_msg %>
    </div>
<% } %>

<% if(typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="bg-[#ffebe8] border border-[#ffa4a4] text-[#be4b49] px-4 py-3 rounded text-center mb-4" role="alert">
        <%= error_msg %>
    </div>
<% } %>

<% if(typeof error !== 'undefined' && error.length > 0) { %>
    <div class="bg-[#ffebe8] border border-[#ffa4a4] text-[#be4b49] px-4 py-3 rounded text-center mb-4" role="alert">
        <%= error %>
    </div>
<% } %>
