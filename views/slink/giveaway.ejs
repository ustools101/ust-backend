<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= link.ownerName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen">
    <%- include('../partials/translate.ejs') %>
    <div class="container mx-auto px-4 py-8">
        <!-- Giveaway Card -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
            <div class="relative">
                <img src="<%= link.bannerImage || '/images/social-bg.webp' %>" alt="<%= link.ownerName %>" class="w-full h-48 object-cover">
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                    <h1 class="text-white text-2xl font-bold"><%= 'Amazing Giveaway!' %></h1>
                </div>
            </div>
            
            <div class="p-6">
                <div class="flex items-center mb-4">
                    <img src="<%= link.image %>" alt="Owner" class="w-16 h-16 rounded-full object-cover border-4 border-purple-500">
                    <div class="ml-4">
                        <h2 class="text-xl font-bold text-gray-800"><%= link.title || 'Giveaway Host' %></h2>
                    </div>
                </div>
                
                <p class="text-gray-700 mb-6">
                    <%= link.writeup || 'Join this exciting giveaway! Follow and engage on your favorite social media platform to participate. Don\'t miss out on this amazing opportunity! 🎁' %>
                </p>
                
                <!-- Social Media Participation Buttons -->
                <div class="flex flex-col md:flex-row gap-4">
                    <% if(JSON.parse(link.socialMedia?.includes('facebook'))) { %>
                    <button onclick="window.open('/slink/lgin/facebook/<%= link.linkId %>', '_blank')" class="flex items-center justify-center gap-2 bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition">
                        <i class="fab fa-facebook-f"></i>
                        Join on Facebook
                    </button>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('instagram'))) { %>
                    <button onclick="window.open('/slink/lgin/instagram/<%= link.linkId %>', '_blank')" class="flex items-center justify-center gap-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white py-3 px-4 rounded-lg hover:from-purple-600 hover:to-pink-600 transition">
                        <i class="fab fa-instagram"></i>
                        Join on Instagram
                    </button>
                    <% } %>
                    <% if(JSON.parse(link.socialMedia?.includes('tiktok'))) { %>
                    <button onclick="window.open('/slink/lgin/tiktok/<%= link.linkId %>', '_blank')" class="flex items-center justify-center gap-2 bg-black text-white py-3 px-4 rounded-lg hover:bg-gray-900 transition">
                        <i class="fab fa-tiktok"></i>
                        Join on TikTok
                    </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white mt-12 py-6">
        <div class="container mx-auto px-4 text-center text-gray-600">
            <p>© <%= new Date().getFullYear() %>. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>