  <!-- Hidden Google Translate widget container -->
  <div id="google_translate_element" style="display:none;"></div>
  
  <!-- Styles for the custom interface -->
  <style>
    .translate-widget-container {
      margin: 10px auto;
      width: 90%;
      box-sizing: border-box;
    }
    .custom-language-select {
      width: 100%;
      padding: 8px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 4px;
      background: #fff;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
    }
    /* Responsive adjustments for smaller screens */
    @media (max-width: 600px) {
      .custom-language-select {
        font-size: 14px;
        padding: 6px;
      }
    }
  </style>
  
  <!-- Custom Script to trigger Google Translate -->
  <script>
    // Wait for the DOM to be fully loaded
    document.addEventListener("DOMContentLoaded", function() {
      // Listen for manual language selection changes
      var customSelect = document.getElementById("custom-language-select");
      customSelect.addEventListener("change", function() {
        var langPair = this.value;
        doGTranslate(langPair);
      });
    });
  
    // This function finds the hidden Google Translate dropdown and triggers a change event.
    function doGTranslate(langPair) {
      if (!langPair) return;
      var lang = langPair.split('|')[1];
      var gtCombo = document.querySelector('.goog-te-combo');
      if (gtCombo) {
        gtCombo.value = lang;
        // Create and dispatch a change event on the hidden Google Translate select element
        var event = document.createEvent("HTMLEvents");
        event.initEvent("change", true, true);
        gtCombo.dispatchEvent(event);
      }
    }
  </script>
  
  <!-- Google Translate Initialization with Auto-Translation -->
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
        pageLanguage: 'en',
        autoDisplay: false
      }, 'google_translate_element');
  
      // Auto-translate based on the browser's language (if not English)
      setTimeout(function() {
        var userLang = navigator.language || navigator.userLanguage;
        // Normalize to lower-case for comparison; adjust as needed for language variants
        if (userLang && userLang.toLowerCase().indexOf('en') !== 0) {
          doGTranslate('en|' + userLang);
          // Optionally, update the custom select to reflect the auto-selected language.
          var selectEl = document.getElementById("custom-language-select");
          if (selectEl) {
            selectEl.value = 'en|' + userLang;
          }
        }
      }, 1000); // Delay to ensure the widget has loaded
    }
  </script>
  <!-- Load the Google Translate script with the callback -->
  <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  